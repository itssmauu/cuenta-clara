# Copy this file to `.env` and replace the placeholder values.
# `.env` is git-ignored: never commit real secrets.

# ── PostgreSQL (Docker Compose) ─────────────────────────
POSTGRES_USER=cuentaclara
# Use URL-safe characters (letters, digits, - _ .): it is embedded in DATABASE_URL
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=cuentaclara
# Host port; the container is only reachable from localhost
POSTGRES_PORT=5432

# ── Backend ─────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_PORT=8000
# Used when running the API outside Docker (uvicorn / alembic from backend/).
# Inside Docker Compose this is overridden to point at the `db` service.
DATABASE_URL=postgresql+psycopg://cuentaclara:change-me-local-only@localhost:5432/cuentaclara
# A separate, disposable database: the test suite drops and recreates its schema
TEST_DATABASE_URL=postgresql+psycopg://cuentaclara:change-me-local-only@localhost:5432/cuentaclara_test

# ── Auth ────────────────────────────────────────────────
# Signs access tokens. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-48-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Browsers accept Secure cookies on http://localhost, so this stays true even locally
COOKIE_SECURE=true

# ── Abuse protection ────────────────────────────────────
LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=3/minute
EMAIL_RATE_LIMIT=10/hour
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ── HTTP ────────────────────────────────────────────────
# The only origin allowed to call the API with cookies (the Next.js app)
FRONTEND_ORIGIN=http://localhost:3000
