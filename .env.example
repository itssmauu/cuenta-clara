# Copy this file to `.env` and replace the placeholder values.
# `.env` is git-ignored: never commit real secrets.

# ── PostgreSQL (Docker Compose) ─────────────────────────
POSTGRES_USER=cuentaclara
# Use URL-safe characters (letters, digits, - _ .): it is embedded in DATABASE_URL
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=cuentaclara
# Host port; the container is only reachable from localhost
POSTGRES_PORT=5432

# ── Backend ─────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_PORT=8000
# Used when running the API outside Docker (uvicorn / alembic from backend/).
# Inside Docker Compose this is overridden to point at the `db` service.
DATABASE_URL=postgresql+psycopg://cuentaclara:change-me-local-only@localhost:5432/cuentaclara
# A separate, disposable database: the test suite drops and recreates its schema
TEST_DATABASE_URL=postgresql+psycopg://cuentaclara:change-me-local-only@localhost:5432/cuentaclara_test

# ── Auth ────────────────────────────────────────────────
# Signs access tokens. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-48-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Browsers accept Secure cookies on http://localhost, so this stays true even locally
COOKIE_SECURE=true

# ── Abuse protection ────────────────────────────────────
LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=3/minute
EMAIL_RATE_LIMIT=10/hour
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Proxies in front of the web app that append the visitor's IP to X-Forwarded-For.
# 0 = none (local). 1 = one HTTPS proxy (Caddy, nginx, the hosting platform). Never trust
# more hops than you really have: an extra one lets clients pick their own IP.
TRUSTED_PROXY_HOPS=0
# Where rate-limit counters live. memory:// is fine for one server; serverless (Vercel)
# needs a shared Redis, e.g. Upstash: rediss://default:<token>@<host>:6379 (REDIS_URL works too)
RATE_LIMIT_STORAGE_URI=memory://
# Vercel only: the same 48+ random characters in both projects (API: PROXY_SECRET,
# web: API_PROXY_SECRET). Empty locally. python -c "import secrets; print(secrets.token_urlsafe(48))"
PROXY_SECRET=
API_PROXY_SECRET=

# ── HTTP ────────────────────────────────────────────────
# The only origin allowed to call the API with cookies (the Next.js app)
FRONTEND_ORIGIN=http://localhost:3000

# ── Frontend ────────────────────────────────────────────
FRONTEND_PORT=3000
# Where the Next.js server proxies /api/* when running outside Docker (npm run dev)
API_INTERNAL_URL=http://localhost:8000
# Optional. Email shown in the privacy policy to exercise data rights. Read at build time.
# Empty = the documents point to the in-app tools (download or delete your data).
NEXT_PUBLIC_PRIVACY_EMAIL=

# ── Email (password recovery) ───────────────────────────
# Any SMTP provider. With a Gmail account made for this: turn on 2-Step Verification,
# create an app password (myaccount.google.com/apppasswords) and use it below; never
# the account's normal password. Empty = recovery unavailable (in development the
# emails are printed to the API log instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ── Assistant (Balbo) ───────────────────────────────────
# Optional. Get a key at https://aistudio.google.com/apikey and keep it only in your .env
# (never commit it). Empty = the app runs without the assistant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ASSISTANT_MESSAGES_PER_HOUR=30
